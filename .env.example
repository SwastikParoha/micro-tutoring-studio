# Google Gemini  (OPTIONAL - without a key a deterministic fallback is used)
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-1.5-pro was retired by Google. Good current choices:
#   gemini-flash-latest  (tracks the current fast model - default, recommended)
#   gemini-3.5-flash     (pin a specific fast model)
#   gemini-pro-latest    (highest quality, slower/pricier)
GEMINI_MODEL=gemini-flash-latest

# Oak National Academy Open Curriculum API  (OPTIONAL)
# Without a key the app uses the offline Oak dataset that `python main.py setup`
# downloads - same content, no key needed.
# Request a free key: https://open-api.thenational.academy/docs/about-oaks-api/api-keys
OAK_API_KEY=your_oak_api_key_here
OAK_API_BASE_URL=https://open-api.thenational.academy
# Header scheme used to send the key: "bearer" -> Authorization: Bearer <key>, or "x-api-key"
OAK_API_AUTH_SCHEME=bearer

# If true, never make network calls (use the local Oak dataset / bundled sample data)
OFFLINE_MODE=false

# Your tutoring business (shown on workbooks, invoices and reports)
BUSINESS_NAME=Bright Steps Tutoring
TUTOR_NAME=

# Paths (optional overrides)
DB_PATH=database/tutoring.db
OUTPUT_DIR=outputs
OAK_LOCAL_DB_PATH=data/oak-curriculum.sqlite
